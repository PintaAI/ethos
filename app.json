{
  "expo": {
    "name": "ethos",
    "slug": "ethos",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/ios-icon-default.png",
    "scheme": "ethos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "usesAppleSignIn": true,
      "icon": {
        "light": "./assets/images/ios-icon-default.png",
        "dark": "./assets/images/ios-icon-dark.png"
      },
      "bundleIdentifier": "com.rorez.ethos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.rorez.ethos",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/android-icon-foreground.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Ethos to use Face ID to keep your financial data secure."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Ethos to use Face ID to unlock your financial data."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ethos to access your photos for profile images and receipt attachments.",
          "cameraPermission": "Allow Ethos to use your camera for receipt photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ethos to use your camera for receipt photos and scanning.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-localization",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#208AEF",
          "defaultChannel": "default"
        }
      ],
      "expo-background-task",
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "entry": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#208AEF"
            }
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.rorez.ethos.widgets",
          "groupIdentifier": "group.com.rorez.ethos",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "EthosCashflowStatsWidget",
              "displayName": "Cashflow Stats",
              "description": "See your active wallet's balance, income, and expenses.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ]
              }
            },
            {
              "name": "EthosTimeMapWidget",
              "displayName": "Time Map",
              "description": "See today's schedule as a 24-hour time map.",
              "ios": {
                "contentMarginsDisabled": true,
                "supportedFamilies": [
                  "systemLarge"
                ]
              }
            }
          ]
        }
      ],
      "./plugins/withNativeWidgets",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsImageWithMaxCount": 1,
              "supportsText": true
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "image/*",
              "text/plain"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "426ba72c-533d-4fd5-ae43-5259006f1e11"
      }
    },
    "owner": "rorez",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/426ba72c-533d-4fd5-ae43-5259006f1e11"
    }
  }
}
